# ---------------------------------------------------------------------------
# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local
#
# Variables are validated on startup by src/config/env.ts. A missing or invalid
# required variable throws "Environment validation failed" at boot.
# ---------------------------------------------------------------------------

# --- Required in production -------------------------------------------------

# Secret used to sign and verify JWT access tokens (HS256).
# In development a built-in fallback is used, so this may be left unset.
# In production it is REQUIRED — the app refuses to boot without it.
# Generate one with:  openssl rand -base64 64
JWT_SECRET=

# --- Application ------------------------------------------------------------

# Public origin of this app. Used for redirects, sitemap, and robots.txt.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name shown in the UI and PWA manifest.
NEXT_PUBLIC_APP_NAME=React Tailwind Starter

# --- Backend API ------------------------------------------------------------

# Base URL of the external API server.
# Must be set explicitly in production when USE_REAL_API=true.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Route handlers under /api/auth/* call the real backend when true.
# When false they use the in-memory mock service (demo@example.com / password).
#
# NOTE: the mock service is disabled in production builds. Deploying with
# USE_REAL_API=false means login will always fail with a 401 — set this to true
# and point NEXT_PUBLIC_API_BASE_URL at a real backend before going live.
USE_REAL_API=false

# Browser-side counterpart of USE_REAL_API. Keep the two values in sync.
NEXT_PUBLIC_USE_REAL_API=false

# --- Monitoring (optional) --------------------------------------------------

# Sentry DSN for error reporting. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Build metadata surfaced in error reports.
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_APP_VERSION=
